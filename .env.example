# Postgres. Locally, whatever you run it in; in production, the pooled
# connection string from the database host. The test suite ignores this and
# starts its own throwaway Postgres.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/tfc"

# Optional. Connections one process may hold open. Defaults to 1 in production
# (a serverless function scales by cloning, not by pooling) and 10 elsewhere.
# DATABASE_POOL_MAX=10

# Signs the session cookie. Any long random string, secret in production:
# generate one with `openssl rand -base64 32`. Changing it signs every fan out.
# The test suite sets its own and ignores this.
BETTER_AUTH_SECRET=""

# Where this app is reached. Every link TFC emails is built from it, and an
# email is read somewhere that has no request to take an origin from. Left
# unset it falls back to wherever this process is listening, which is right for
# `pnpm dev` and for the test suite and wrong everywhere else — so it is
# required as soon as RESEND_API_KEY is set, and nothing can reach a real inbox
# carrying a link to localhost.
#
# Set it locally too if the dev server is on a port other than 3000, or is
# reached through a tunnel.
# BETTER_AUTH_URL="https://tfcgeo.com"

# Optional, and nothing in production should set it. Where the server reaches
# the Prismic Document API to import a card; without it the client is built
# from the repository name in prismic.config.json, which resolves to the CDN
# endpoint. Set it to develop against a second repository, or against a
# stand-in for one.
# PRISMIC_API_URL="https://tfc-landing.cdn.prismic.io/api/v2"

# Resend, which delivers the two emails TFC sends: confirming an address, and
# setting a new password. Leave it unset and those messages are written to the
# server log instead, link and all — which is how this repo is worked on
# without anyone verifying a sending domain first.
#
# Setting it makes EMAIL_FROM and BETTER_AUTH_URL required. See the Email
# section of README.md for what has to happen in DNS before either works.
# RESEND_API_KEY="re_..."

# Who the email is from. Must be on a domain verified with Resend — a sender on
# an unverified domain is refused, which is the failure this is most likely to
# produce.
# EMAIL_FROM="TFC Predictions <no-reply@mail.tfcgeo.com>"

# Optional, and nothing in production should set it. Where to reach Resend; the
# test suite points it at a stand-in so the transport itself is exercised
# rather than a mock of it.
# RESEND_BASE_URL="https://api.resend.com"

# Optional. How long after a card's scheduled start every Bout still open is
# locked regardless, in hours. Defaults to six, which is an evening of fights.
#
# This is the last of the three automatic backstops behind the admin who locks
# Bouts as a card is fought (ADR-0006): reaching it means somebody stopped
# advancing the Lock partway through an event, so it is deliberately generous
# rather than tight. It is also how long a card stays the card being shown on
# /predictions, because past it nothing on the card can be open.
# LOCK_SWEEP_HOURS=6
